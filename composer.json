{
    "name": "synolia/sylius-maintenance-plugin",
    "type": "sylius-plugin",
    "description": "Plugin for Sylius when your website is under maintenance",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "maintenance"
    ],
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.2",
        "jaybizzle/crawler-detect": "^1.2",
        "sylius/sylius": "^2.2",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^3.0",
        "phpro/grumphp": "^2.27",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "povils/phpmnd": "^3.6",
        "rector/rector": "^2.9",
        "seld/jsonlint": "^1.12",
        "squizlabs/php_codesniffer": "^3.13",
        "sylius-labs/coding-standard": "^4.5",
        "sylius/test-application": "^2.2@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "Synolia\\SyliusMaintenancePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Synolia\\SyliusMaintenancePlugin\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    },
    "conflict": {
        "sylius/test-application": "v2.0.0-ALPHA.1"
    }
}
