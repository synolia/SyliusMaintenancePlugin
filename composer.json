{
    "name": "synolia/sylius-maintenance-plugin",
    "type": "sylius-plugin",
    "description": "Plugin for Sylius when your website is under maintenance",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "maintenance"
    ],
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.3",
        "jaybizzle/crawler-detect": "^1.2",
        "sylius/sylius": "^2.2",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "friendsoftwig/twigcs": "^6.4.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^3.0",
        "phpro/grumphp": "^2.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^9.5",
        "povils/phpmnd": "^3.0",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.11",
        "sylius-labs/coding-standard": "^4.3",
        "sylius/test-application": "^2.2@alpha",
        "symfony/browser-kit": "^6.4 | ^7.4 | ^8.0",
        "symfony/css-selector": "^6.4 | ^7.4 | ^8.0",
        "symfony/debug-bundle": "^6.4 | ^7.4 | ^8.0",
        "symfony/dotenv": "^6.4 | ^7.4 | ^8.0",
        "symfony/intl": "^6.4 | ^7.4 | ^8.0",
        "symfony/web-profiler-bundle": "^6.4 | ^7.4 | ^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true
        }
    },
    "autoload": {
        "psr-4": {
            "Synolia\\SyliusMaintenancePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Synolia\\SyliusMaintenancePlugin\\": "tests/"
        }
    },
    "scripts": {
        "ecs": "ecs check -c ruleset/ecs.php --ansi --clear-cache",
        "fix-ecs": "@ecs --fix",
        "phpmd": "phpmd analyze src --format ansi --ruleset ruleset/.php_md.xml",
        "phpstan": "phpstan analyse src -c ruleset/phpstan.neon",
        "phpunit": "phpunit tests/PHPUnit --colors=always",
        "tests": [
            "@ecs",
            "@phpmd",
            "@phpstan",
            "@phpunit"
        ],
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    },
    "conflict": {
        "sylius/test-application": "v2.0.0-ALPHA.1"
    }
}
